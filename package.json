{
  "name": "auto-insight",
  "version": "1.0.0",
  "description": "车企财报与行业洞察 — 服务端联网检索 + 每日邮件推送",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "digest:gen": "node -e \"import('./src/cron.js').then(m=>m.generateDaily()).then(d=>console.log('已生成日报',d.date)).catch(e=>{console.error(e);process.exit(1)})\"",
    "digest:send": "node -e \"import('./src/cron.js').then(m=>m.sendDaily()).then(()=>console.log('已发送')).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3"
  }
}
